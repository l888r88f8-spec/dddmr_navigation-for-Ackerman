        - /GridCoarse1/Topic1
        - /GridCorridor1/Topic1
        - /WheelSupport1/Topic1
        - /TF1/Frames1
      Splitter Ratio: 0.5
    Tree Height: 806
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Pose Estimate1
      - /3D Goal Pose1
    Name: Tool Properties
    Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: MapGround
