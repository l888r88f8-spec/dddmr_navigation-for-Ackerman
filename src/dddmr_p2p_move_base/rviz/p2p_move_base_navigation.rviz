    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /MapCloud1/Topic1
        - /MapGround1/Topic1
        - /GlobalPath1/Topic1
        - /BestTrajectory1/Topic1
        - /AggregatedObstacles1/Topic1
