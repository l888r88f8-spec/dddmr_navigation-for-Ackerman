# Generated by grid_global_planner/CMakeLists.txt. Do not edit.
#
# This must stay a standalone install-time script.  Passing the same code as
# install(CODE "...") is unsafe under AMENT_CMAKE_SYMLINK_INSTALL=ON: ament's
# install() wrapper re-expands ARGN unquoted, so semicolons from an
# interpolated CMake list split the code argument and truncate the generated
# cmake_install.cmake at the first list item.
set(retired_root "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/share/@PROJECT_NAME@")
foreach(retired_file IN ITEMS @GRID_RETIRED_SHARE_FILES@)
  if(EXISTS "${retired_root}/${retired_file}" OR IS_SYMLINK "${retired_root}/${retired_file}")
    message(STATUS "Removing retired grid asset: ${retired_root}/${retired_file}")
    file(REMOVE "${retired_root}/${retired_file}")
  endif()
endforeach()
