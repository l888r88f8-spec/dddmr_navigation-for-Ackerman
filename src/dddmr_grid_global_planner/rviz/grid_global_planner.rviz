      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Volatile
        Filter size: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /navigation/preprocessed_cloud
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: PlannerTerrain
      Namespaces:
        {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /grid_global_planner/terrain
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: PlannerCoarse
